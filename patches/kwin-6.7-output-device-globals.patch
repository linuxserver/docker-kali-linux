+
+void OutputDeviceV2Interface::retire()
+{
+    if (!d->m_handle) {
+        // Already withdrawn.
+        return;
+    }
+
     d->m_doneTimer.stop();
+    disconnect(d->m_handle, nullptr, this, nullptr);
+    d->m_handle = nullptr;
 
