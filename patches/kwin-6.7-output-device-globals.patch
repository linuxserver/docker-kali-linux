 }
 
+void OutputDeviceV2Interface::remove()
+{
+    retire();
+
+    if (d->isGlobal() && !d->isGlobalRemoved()) {
+        // Unpublish the global as OutputInterface does for wl_output: a client
+        // that still holds the name may bind it (and is told it is gone), a
+        // wl_fixes v2 client can acknowledge the removal, and the global is
+        // destroyed once they all did or the deferred destroy fires. The
+        // destroy_global hook deletes this device then; it may run right here.
+        d->globalRemove();
+        return;
+    }
+    delete this;
+}
+
+void OutputDeviceV2Interface::announceGlobal(Display *display)
+{
+    // A bind through the global lands in the same resource map as a registry
+    // announcement, so bind_resource, every update and the removed event on
+    // withdrawal reach it alike.
+    d->init(*display, s_version);
+}
+
+void OutputDeviceV2InterfacePrivate::kde_output_device_v2_destroy_global()
+{
+    // Reached from the deferred destroy (global already gone) or from the
+    // withdrawn notification (every registry let go; the destructor destroys
+    // the global). Either way the device has nothing left to serve.
+    delete q;
+}
